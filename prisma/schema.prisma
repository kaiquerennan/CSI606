generator client {
  provider = "prisma-client-js"
  engineType = "binary"
  binaryTargets = ["native"]
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id     Int      @id @default(autoincrement())
  nome   String
  email  String   @unique
  senha  String?  // Adicionado campo senha
  vendas Vendas[]
  ativo  Boolean   @default(true)
}

model Vendas {
  id        Int      @id @default(autoincrement())
  valor     Float
  data      DateTime @default(now())

  // Definição da relação (Foreign Key)
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
}

model Produto {
  id  Int             @id @default(autoincrement())
  descricao           String
  preco               Float
  grupo               String?
  estoque             Decimal     @db.Decimal(10,2)
  ativo               Boolean     @default(true)
}

