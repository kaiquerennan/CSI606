generator client {
  provider      = "prisma-client-js"
  engineType    = "binary"
  binaryTargets = ["native"]
  output        = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id     Int      @id @default(autoincrement())
  nome   String
  email  String   @unique
  senha  String? // Adicionado campo senha
  vendas Vendas[]
  ativo  Boolean  @default(true)
}

model Vendas {
  id        Int           @id @default(autoincrement())
  valor     Float
  data      DateTime      @default(now())
  status    String        @default("concluida")
  usuarioId Int
  usuario   Usuario       @relation(fields: [usuarioId], references: [id])
  itens     itensVendas[]
}

model Produto {
  id        Int           @id @default(autoincrement())
  descricao String
  preco     Float
  grupo     String?
  estoque   Decimal       @db.Decimal(10, 2)
  ativo     Boolean       @default(true)
  categoria String
  itens     itensVendas[]
}

model itensVendas {
  id            Int      @id @default(autoincrement())
  vendaId       Int
  produtoId     Int
  quantidade    Decimal  @db.Decimal(10, 2)
  valorUnitario Decimal  @db.Decimal(10, 2)
  valorTotal    Decimal  @db.Decimal(10, 2)
  data          DateTime @default(now())

  vendas  Vendas  @relation(fields: [vendaId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])

  @@map("itens_vendas")
}
